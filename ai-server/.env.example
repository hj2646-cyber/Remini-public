APP_ENV=dev
HOST=127.0.0.1
PORT=8000
APP_TIMEZONE=Asia/Seoul
ONLINE_SEARCH_ENABLED=true

# Local LLM (for now)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:31b
# Lower-spec PCs can switch to a smaller Ollama model (e.g. gemma2:9b, qwen3:8b).

# TTS (옵션: supertonic | mms | qwen3)
TTS_PROVIDER=qwen3
SUPERTONIC_VOICE=F3
SUPERTONIC_SPEED=1.15
SUPERTONIC_STEPS=4

# Qwen3-TTS CustomVoice (사전 정의 화자 단순 TTS)
# speakers: aiden | dylan | eric | ono_anna | ryan | serena | sohee | uncle_fu | vivian
# sohee = 한국어 자연스러움
QWEN3_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
QWEN3_TTS_SPEAKER=sohee
QWEN3_TTS_LANGUAGE=korean
QWEN3_TTS_DEVICE=auto

# Voice clone (보호자 음성 복제 — Qwen3-TTS Base + 참조 오디오)
VOICE_CLONE_ENDPOINT=
VOICE_CLONE_TIMEOUT_SEC=120
VOICE_CLONE_LANGUAGE_CODE=ko
VOICE_CLONE_AUDIO_FORMAT=wav
VOICE_CLONE_DEVICE=auto
VOICE_PROFILE_MAX_SAMPLES=8
VOICE_PROFILE_MAX_MB_PER_FILE=15

# Retrieval
EMBEDDING_MODEL=BAAI/bge-m3
TOP_K=5

# DB (optional for now, required for pgvector mode)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/dementia
AURADB_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=remini

# STT
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ko

OLLAMA_TEMPERATURE=0.4
OLLAMA_TOP_P=0.9
OLLAMA_REPEAT_PENALTY=1.1
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=512

# Proactive policy
PROACTIVE_MIN_CONFIDENCE=0.6
PROACTIVE_GREETING_COOLDOWN_SEC=120
PROACTIVE_DROWSY_COOLDOWN_SEC=45
PROACTIVE_GLOBAL_COOLDOWN_SEC=20
PROACTIVE_EYES_CLOSED_SEC=2.2
